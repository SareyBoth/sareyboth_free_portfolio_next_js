// Prisma schema for SareyBothPortfolio CMS
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Better Auth Core & Plugin Models
// -----------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          String    @default("EDITOR") // "OWNER" | "EDITOR"
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions Session[]
  accounts Account[]

  @@map("user")
}

model Session {
  id             String   @id @default(cuid())
  userId         String
  token          String   @unique
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String   @id @default(cuid())
  key         String   @unique
  count       Int      @default(0)
  lastRequest BigInt

  @@map("rate_limit")
}

// -----------------------------------------------------------------------------
// Singletons (Site, Profile, Presentation, Contact, Footer, Labels)
// -----------------------------------------------------------------------------

model SiteSettings {
  id          String   @id @default("singleton")
  title       String   @default("SareyBoth — SareyBothPortfolio")
  description String   @default("Personal portfolio for SareyBoth")
  siteUrl     String   @default("https://sareybothportfolio.example.com")
  locale      String   @default("en-US")
  indexable   Boolean  @default(false)
  socialImage Json?    // { src, alt, width, height }
  faviconUrl  String?
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("site_settings")
}

model Profile {
  id           String   @id @default("singleton")
  name         String   @default("SareyBoth")
  descriptor   String   @default("Community Program Coordinator")
  introduction String   @default("I organize neighborhood learning initiatives...")
  biography    Json     // string[]
  location     String?
  availability String?
  resumeUrl    String?
  contactEmail String   @default("sareyboth@example.com")
  portrait     Json?    // { src, alt, width, height }
  primaryCta   Json?    // { label, href }
  secondaryCta Json?    // { label, href }
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("profile")
}

model PresentationSettings {
  id                String    @id @default("singleton")
  defaultPreset     String    @default("minimal") // "minimal" | "warm" | "modern"
  defaultMode       String    @default("system")  // "light" | "dark" | "system"
  fontPreset        String    @default("sans")    // "sans" | "serif"
  density           String    @default("comfortable") // "compact" | "comfortable" | "spacious"
  radius            String    @default("subtle")  // "sharp" | "subtle" | "rounded"
  publishedSnapshot Json?     // Validated active settings for public rendering
  publishedAt       DateTime?
  version           Int       @default(1)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("presentation_settings")
}

model ContactSettings {
  id                       String   @id @default("singleton")
  recipientEmail           String   @default("sareyboth@example.com")
  mode                     String   @default("form") // "form" | "mailto"
  subjectPrefix            String?
  acknowledgementText      String   @default("Message received! Thank you for reaching out.")
  openEmailAppButtonLabel  String   @default("Open email app")
  emailAppHelperText       String   @default("Clicking 'Open email app' opens your default mail client with a pre-filled draft.")
  directEmailFallbackLabel String   @default("Prefer to write directly? Email")
  version                  Int      @default(1)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@map("contact_settings")
}

model FooterSettings {
  id              String   @id @default("singleton")
  copyrightNotice String?
  showSectionsNav Boolean  @default(true)
  showSocialLinks Boolean  @default(true)
  customText      String?
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("footer_settings")
}

model LabelsSettings {
  id                       String   @id @default("singleton")
  exploreHighlightsCta     String   @default("Explore My Highlights")
  contactCta               String   @default("Contact Me")
  downloadResumeCta        String   @default("Download Resume (PDF)")
  allCategoriesFilter      String   @default("All")
  emptyHighlightsText      String   @default("No highlights match this category yet.")
  emptyArticlesText        String   @default("No journal entries are published right now.")
  sampleTestimonialsNotice String   @default("Sample testimonials for template demonstration — replace with real reflections in portfolio.json.")
  version                  Int      @default(1)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@map("labels_settings")
}

// -----------------------------------------------------------------------------
// Structure & Categorization
// -----------------------------------------------------------------------------

model Section {
  id           String   @id // "home", "about", "strengths", etc.
  title        String
  navLabel     String?
  subtitle     String?
  enabled      Boolean  @default(true)
  displayOrder Int      @default(0)
  options      Json?    // section-specific validated options
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([displayOrder])
  @@map("section")
}

model SocialLink {
  id           String   @id @default(cuid())
  platform     String
  label        String
  url          String
  iconKey      String?
  displayOrder Int      @default(0)
  enabled      Boolean  @default(true)
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([displayOrder])
  @@map("social_link")
}

model QuickFact {
  id           String   @id @default(cuid())
  label        String
  value        String
  displayOrder Int      @default(0)
  enabled      Boolean  @default(true)
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([displayOrder])
  @@map("quick_fact")
}

model ValueItem {
  id           String   @id @default(cuid())
  title        String
  description  String
  displayOrder Int      @default(0)
  enabled      Boolean  @default(true)
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([displayOrder])
  @@map("value_item")
}

model StrengthGroup {
  id           String         @id // slug e.g. "program-facilitation"
  category     String
  description  String?
  displayOrder Int            @default(0)
  enabled      Boolean        @default(true)
  version      Int            @default(1)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  items        StrengthItem[]

  @@index([displayOrder])
  @@map("strength_group")
}

model StrengthItem {
  id           String        @id @default(cuid())
  groupId      String
  name         String
  description  String?
  displayOrder Int           @default(0)
  enabled      Boolean       @default(true)
  version      Int           @default(1)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  group        StrengthGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, displayOrder])
  @@map("strength_item")
}

model HighlightCategory {
  id           String      @id @default(cuid())
  name         String      @unique
  slug         String      @unique
  description  String?
  displayOrder Int         @default(0)
  version      Int         @default(1)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  highlights   Highlight[]

  @@index([displayOrder])
  @@map("highlight_category")
}

model Tag {
  id            String         @id @default(cuid())
  name          String         @unique
  slug          String         @unique
  version       Int            @default(1)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  highlightTags HighlightTag[]
  articleTags   ArticleTag[]

  @@map("tag")
}

// -----------------------------------------------------------------------------
// Core Content Entities (Highlights, Articles, Journey, Achievements, etc.)
// -----------------------------------------------------------------------------

model Highlight {
  id                 String             @id @default(cuid())
  slug               String             @unique
  title              String
  summary            String
  categoryId         String?
  roleOrContribution String
  context            String
  outcomes           Json               // string[]
  date               String?            // portfolio date string e.g. "2025-04"
  featured           Boolean            @default(false)
  displayOrder       Int                @default(0)
  coverImage         Json?              // media asset reference
  gallery            Json?              // media asset array
  externalLinks      Json?              // { label, url }[]
  relatedSlugs       Json?              // string[]
  body               Json               // ContentBlock[]
  published          Boolean            @default(false)
  publishedAt        DateTime?
  publishedSnapshot  Json?              // Versioned snapshot used for public selectors
  archivedAt         DateTime?
  version            Int                @default(1)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  category HighlightCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags     HighlightTag[]

  @@index([slug])
  @@index([published, displayOrder])
  @@index([categoryId])
  @@map("highlight")
}

model HighlightTag {
  highlightId String
  tagId       String
  highlight   Highlight @relation(fields: [highlightId], references: [id], onDelete: Cascade)
  tag         Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([highlightId, tagId])
  @@map("highlight_tag")
}

model JourneyEntry {
  id            String   @id // slug e.g. "community-program-coordinator"
  type          String   // "employment" | "volunteering" | "course" | "education" | "milestone"
  title         String
  organization  String?
  location      String?
  startDate     String   // e.g. "2023-05"
  endDate       String?  // e.g. "Present" or "2024-11"
  isCurrent     Boolean  @default(false)
  datePrecision String   @default("month") // "year" | "month" | "day"
  description   String
  highlights    Json?    // string[]
  displayOrder  Int      @default(0)
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([displayOrder])
  @@map("journey_entry")
}

model Achievement {
  id              String   @id // slug
  title           String
  issuer          String?
  date            String?  // e.g. "2025-05"
  datePrecision   String   @default("month")
  description     String?
  image           Json?    // media asset reference
  verificationUrl String?
  displayOrder    Int      @default(0)
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([displayOrder])
  @@map("achievement")
}

model Testimonial {
  id           String   @id // slug
  quote        String
  name         String
  relationship String
  avatar       Json?    // media asset reference
  isSample     Boolean  @default(false)
  displayOrder Int      @default(0)
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([displayOrder])
  @@map("testimonial")
}

model Service {
  id           String   @id // slug
  title        String
  description  String
  deliverables Json?    // string[]
  ctaLabel     String?
  ctaTarget    String?  @default("#contact")
  iconKey      String?
  displayOrder Int      @default(0)
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([displayOrder])
  @@map("service")
}

model Article {
  id                String       @id @default(cuid())
  slug              String       @unique
  title             String
  summary           String
  date              String       // e.g. "2025-05-14"
  readingTime       String?
  coverImage        Json?
  body              Json         // ContentBlock[]
  published         Boolean      @default(false)
  publishedAt       DateTime?
  publishedSnapshot Json?        // Versioned snapshot for public reads
  archivedAt        DateTime?
  displayOrder      Int          @default(0)
  version           Int          @default(1)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  tags ArticleTag[]

  @@index([slug])
  @@index([published, displayOrder])
  @@map("article")
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@map("article_tag")
}

model Interest {
  id           String   @id // slug
  name         String
  category     String?
  description  String
  iconKey      String?
  displayOrder Int      @default(0)
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([displayOrder])
  @@map("interest")
}

model GalleryItem {
  id           String   @id // slug
  title        String
  caption      String
  date         String?
  category     String?
  image        Json     // media asset reference
  displayOrder Int      @default(0)
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([displayOrder])
  @@map("gallery_item")
}

// -----------------------------------------------------------------------------
// Media & Communication
// -----------------------------------------------------------------------------

model MediaAsset {
  id               String   @id @default(cuid())
  storageKey       String   @unique
  originalFilename String
  mimeType         String
  byteSize         Int
  width            Int?
  height           Int?
  altText          String   @default("")
  caption          String?
  uploaderId       String?
  isPublic         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([storageKey])
  @@index([isPublic])
  @@map("media_asset")
}

model ContactMessage {
  id            String   @id @default(cuid())
  name          String
  email         String
  subject       String
  message       String
  status        String   @default("unread") // "unread" | "read" | "archived"
  internalNotes String?
  ipAddress     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, createdAt])
  @@map("contact_message")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     String   // "create", "update", "delete", "publish", "unpublish", "archive", "login", etc.
  entityType String   // "highlight", "article", "profile", "user", etc.
  entityId   String?
  details    Json?    // non-secret change summary
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_log")
}
