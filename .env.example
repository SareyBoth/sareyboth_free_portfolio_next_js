# ==============================================================================
# SareyBothPortfolio CMS — Environment Configuration Example
# ==============================================================================
# Copy this file to .env and adjust variables as appropriate for your environment.
# Never commit real secrets or production passwords into version control.

# PostgreSQL Connection Strings
# ------------------------------------------------------------------------------
# App runtime connection string (points to the openfolio_next database):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/openfolio_next?schema=public"

# Admin connection string (used by bootstrap scripts to create database if missing):
DATABASE_ADMIN_URL="postgresql://postgres:postgres@localhost:5432/postgres"

# Test database connection string (used by automated integration tests):
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/openfolio_next_test?schema=public"

# Better Auth Configuration
# ------------------------------------------------------------------------------
# 32+ character random secret used for session signing and encryption:
BETTER_AUTH_SECRET="change-this-to-a-secure-random-secret-key-at-least-32-characters"

# Base URL where this Next.js app is served (must match incoming host headers):
BETTER_AUTH_URL="http://localhost:3000"

# Initial Owner Bootstrap Credentials (used by scripts/bootstrap-owner.ts)
# ------------------------------------------------------------------------------
INITIAL_OWNER_EMAIL="sareyboth@example.com"
INITIAL_OWNER_NAME="SareyBoth"
INITIAL_OWNER_PASSWORD=""

# SMTP Email Configuration (for password reset workflow)
# ------------------------------------------------------------------------------
# Default development values target the local Mailpit service in Docker Compose:
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@example.com"

# Media Storage Configuration
# ------------------------------------------------------------------------------
# Persistent directory on disk for media uploads (outside web root):
MEDIA_STORAGE_DIR="./uploads"

# Next.js Server & Environment
# ------------------------------------------------------------------------------
NODE_ENV="development"
PORT="3000"
